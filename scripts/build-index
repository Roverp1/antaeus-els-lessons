#!/usr/bin/env python3
"""Regenerate root index.html from lessons/, exercises/ and reference/.

Idempotent: a second run produces an identical file, so the pre-commit hook
can always stage index.html without introducing churn.
"""
import html
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SECTIONS = ("Lessons", "Exercises", "Reference")
TITLE_RE = re.compile(r"<title>(.*?)</title>", re.S)


def page_title(path: Path) -> str:
    m = TITLE_RE.search(path.read_text(encoding="utf-8"))
    if not m:
        sys.exit(f"error: no <title> in {path}")
    return m.group(1).strip()


def sort_key(path: Path):
    n = re.match(r"(\d+)", path.stem)
    return (0, int(n.group(1))) if n else (1, path.stem.lower())


def section_html(name: str) -> str:
    files = sorted((ROOT / name.lower()).glob("*.html"), key=sort_key)
    if not files:
        return ""
    items = "\n".join(
        f'      <li><a href="{name.lower()}/{p.name}">{html.escape(page_title(p))}</a></li>'
        for p in files
    )
    return f'    <h2>{name}</h2>\n    <ol class="practice-list">\n{items}\n    </ol>'


def main() -> None:
    rendered = []
    for s in SECTIONS:
        h = section_html(s)
        if h:
            rendered.append(h)
    sections = "\n\n".join(rendered)
    page = f"""<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>English tutoring · Course index</title>
    <link rel="stylesheet" href="assets/pico.min.css" />
    <link rel="stylesheet" href="assets/fonts.css" />
    <link rel="stylesheet" href="assets/course.css" />
  </head>
  <body>
    <header class="lesson-header">
      <p class="meta">Course index</p>
      <h1>English tutoring</h1>
      <p class="ru">Уроки, упражнения и справочники</p>
    </header>

{sections}

    <p class="followup">Generated by scripts/build-index. Add a lesson and the index updates itself.</p>
  </body>
</html>
"""
    target = ROOT / "index.html"
    old = target.read_text(encoding="utf-8") if target.exists() else None
    if old != page:
        target.write_text(page, encoding="utf-8")
        print(f"build-index: wrote {target.relative_to(ROOT)}")
    else:
        print("build-index: index.html unchanged")


if __name__ == "__main__":
    main()
